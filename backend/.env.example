NODE_ENV=production
PORT=3000

# ── MySQL ──────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tiktok_manager
DB_USER=tiktok_user
DB_PASS=CHANGE_THIS_STRONG_PASSWORD

# ── Security ───────────────────────────────────────────────────────────────────
# Tạo random key: openssl rand -hex 32
API_KEY=CHANGE_THIS_RANDOM_API_KEY_FOR_PHONES

# Tạo random secret: openssl rand -hex 64
JWT_SECRET=CHANGE_THIS_RANDOM_JWT_SECRET_MINIMUM_32_CHARS

# Dashboard admin login
ADMIN_USER=admin
ADMIN_PASS=CHANGE_THIS_STRONG_ADMIN_PASSWORD

# ── CORS — production: domain của bạn ─────────────────────────────────────────
CORS_ORIGIN=https://yourdomain.com

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# Account lock timeout for phone workers (minutes)
ACCOUNT_LOCK_TIMEOUT_MIN=40

# EmailTick provider (server-side only; AutoTouch calls the VPS API)
EMAILTICK_BASE_URL=https://emailtick.com
EMAILTICK_TIMEOUT_MS=15000
EMAILTICK_RETRY_COUNT=2
EMAILTICK_RETRY_DELAY_MS=250
EMAILTICK_ALLOWED_TYPES=1,2,3,4,5
EMAILTICK_RANDOM_TYPES=3,4,5

# Ghost Inbox (internal Livewire frontend contract; sessions stored per mailbox)
GHOSTINBOX_BASE_URL=https://temp-gmail.ghostinbox.net
GHOSTINBOX_TIMEOUT_MS=15000
GHOSTINBOX_RETRY_COUNT=2
GHOSTINBOX_POLL_INTERVAL_MS=10000

# Dashboard liveness; task lock timeout is configured separately.
DEVICE_OFFLINE_TIMEOUT_SECONDS=1800

# Device Manager: opt-in only after manual migration and HTTPS configuration.
DEVICE_MANAGER_ENABLED=false
# Generate a private 32-byte base64 key; share it with the broker, never commit it.
DEVICE_MANAGER_ENCRYPTION_KEY=
DEVICE_MANAGER_ORIGIN=
# Only the dedicated broker sets this to true; HTTP server does not start it.
DEVICE_MANAGER_SSH_ENABLED=false
DEVICE_MANAGER_WS_PORT=3001

# Gateway-only listener inside SSH tunnel; opt-in, not a public WS endpoint.
DEVICE_MANAGER_GATEWAY_TUNNEL_ENABLED=false
DEVICE_MANAGER_TUNNEL_BIND=127.0.0.1
# Exact trusted Docker bridge / reverse-proxy peers, after deployment review.
DEVICE_MANAGER_TUNNEL_PEERS=
DEVICE_MANAGER_PROXY_PEERS=

# Optional AES-256-GCM for new Instagram credential writes. Keep the key stable.
# Existing plaintext rows are not automatically backfilled.
INSTAGRAM_CREDENTIAL_ENCRYPTION_KEY=
